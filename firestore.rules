rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().active == true; }
    function chef() { return active() && profile().role == 'chef'; }
    function chefEmail() {
      return request.auth.token.email in ['hej@fiskaren.nu', 'karen@fiskaren.nu']
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ((request.resource.data.role == 'saljare' && request.resource.data.active == false)
            || (chefEmail() && request.resource.data.role == 'chef' && request.resource.data.active == true));
      allow update: if chef() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']));
      allow delete: if chef();
    }
    match /leads/{id} {
      allow read, create, update: if active();
      allow delete: if chef() || (active() && resource.data.owner == request.auth.uid);
    }
    match /areas/{id} {
      allow read: if active();
      allow write: if chef();
    }
    // live position during the workday ("Starta dagen") – the chef sees everyone, a seller only themself
    match /live/{uid} {
      allow read: if chef() || (active() && request.auth.uid == uid);
      allow write: if active() && request.auth.uid == uid;
    }
    // one route per seller and day: {uid}_{YYYY-MM-DD}
    match /tracks/{id} {
      allow read: if chef() || (active() && resource.data.uid == request.auth.uid);
      allow create, update: if active() && id.matches(request.auth.uid + '_.*') && request.resource.data.uid == request.auth.uid;
      allow delete: if chef();
    }
    // team chat (Messages)
    match /chats/{id} {
      allow read: if active() && request.auth.uid in resource.data.members;
      allow create: if active() && request.auth.uid in request.resource.data.members;
      allow update: if active() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;
      match /msgs/{m} {
        allow read, create: if active() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;
      }
    }
    match /settings/{id} {
      allow read: if active();
      allow write: if chef();
    }
  }
}
